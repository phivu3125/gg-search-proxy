# ggsearch configuration — copy this file to `.env` and edit.
# Real environment variables always override values set here.

# Listen address for the API server
GGSP_ADDR=:20129

# SQLite database path (holds accounts, API keys, usage)
GGSP_DB=data/ggsearch.db

# Admin token for /v1 admin endpoints (keys, accounts, usage).
# Leave empty to auto-generate: a random token is created on first run,
# printed at startup, and saved to <db-dir>/admin-token.
GGSP_ADMIN_TOKEN=

# Gemini model used for search grounding
GGSP_DEFAULT_MODEL=gemini-2.5-flash

# Upstream HTTP timeout
GGSP_UPSTREAM_TIMEOUT=20s
